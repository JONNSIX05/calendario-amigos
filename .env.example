# ==========================================================
# Configuración de Calendario de Disponibilidad para Amigos
# Copia este archivo a ".env" y ajusta los valores.
# ==========================================================

# Puerto donde escucha el servidor Express (API + Frontend en producción)
PORT=3001

# Clave secreta para firmar las cookies JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Código inicial de un solo uso para registrar la primera cuenta (Administrador)
ADMIN_SETUP_CODE=ADMIN2026

# Ruta del archivo SQLite (relativa a la raíz del proyecto o absoluta)
DB_PATH=./data/calendar.db

# Carpeta donde se guardan los íconos .svg/.png subidos por los usuarios
UPLOAD_DIR=./data/uploads/icons

# Entorno: development | production
NODE_ENV=development

# Pon "true" en producción cuando sirvas la app detrás de HTTPS (Nginx + Certbot)
COOKIE_SECURE=false
